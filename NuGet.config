<?xml version="1.0" encoding="utf-8"?>
<!--
  本项目只使用 nuget.org，不依赖内网 Nexus 源（去掉了用户级配置里的 Nexus / NexusHosted）。
  <clear /> 会丢弃用户级 ~/.nuget/NuGet/NuGet.Config 里继承下来的包源，所以这里必须自带 nuget.org。
  包源映射留着：中央包管理下加了源也不会再出 NU1507。
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
