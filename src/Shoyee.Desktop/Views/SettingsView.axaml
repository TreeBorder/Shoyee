<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Shoyee.Desktop.ViewModels"
             xmlns:nav="using:Shoyee.Desktop.ViewModels.Settings"
             xmlns:settings="using:Shoyee.Desktop.Views.Settings"
             x:Class="Shoyee.Desktop.Views.SettingsView"
             x:DataType="vm:MainViewModel">

  <Grid ColumnDefinitions="200,*">

    <!-- 一级菜单 + 当前一级下的二级菜单 -->
    <Border Grid.Column="0"
            BorderBrush="{DynamicResource BorderSoftBrush}"
            BorderThickness="0,0,1,0">
      <Grid RowDefinitions="*,Auto">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel Margin="12,16,12,8" Spacing="4">
            <ItemsControl ItemsSource="{Binding SettingsSections}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="nav:SettingsSectionViewModel">
                  <StackPanel Margin="0,0,0,2">
                    <Button Classes="side-nav" Classes.active="{Binding IsActive}"
                            Command="{Binding SelectCommand}">
                      <StackPanel Orientation="Horizontal" Spacing="9">
                        <PathIcon Data="{Binding Icon}" Width="16" Height="16"
                                  VerticalAlignment="Center" />
                        <TextBlock Text="{Binding Title}" VerticalAlignment="Center" />
                      </StackPanel>
                    </Button>

                    <!-- 二级菜单：只在当前一级下展开 -->
                    <Border IsVisible="{Binding IsExpanded}"
                            BorderBrush="{DynamicResource BorderSoftBrush}"
                            BorderThickness="1,0,0,0"
                            Margin="22,2,0,4" Padding="8,2,0,2">
                      <ItemsControl ItemsSource="{Binding Pages}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="nav:SettingsPageViewModel">
                            <Button Classes="side-nav sub"
                                    Classes.active="{Binding IsActive}"
                                    Command="{Binding SelectCommand}">
                              <TextBlock Text="{Binding Title}" VerticalAlignment="Center" />
                            </Button>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </Border>
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </ScrollViewer>

        <Button Grid.Row="1" Content="关闭设置" Classes="side-nav"
                Margin="12,8,12,16"
                Command="{Binding BackToChatCommand}" />
      </Grid>
    </Border>

    <!-- 内容区：一级标题 + 当前子页（左对齐，不居中） -->
    <Grid Grid.Column="1" RowDefinitions="Auto,*">

      <StackPanel Margin="30,22,30,0" Spacing="4">
        <TextBlock Text="{Binding SettingsSectionTitle}" Classes="h1" />
        <TextBlock Text="{Binding SettingsSectionSummary}" Classes="caption" />
      </StackPanel>

      <Grid Grid.Row="1">
        <settings:AppearanceSettingsView IsVisible="{Binding IsAppearanceSettings}" />
        <settings:ProfileSettingsView IsVisible="{Binding IsProfileSettings}" />
        <settings:ConnectionSettingsView IsVisible="{Binding IsConnectionSettings}" />
        <settings:PromptSettingsView IsVisible="{Binding IsPromptSettings}" />
        <settings:WorkIndexView IsVisible="{Binding IsWorkIndex}" />
        <settings:WorkSubagentsView IsVisible="{Binding IsWorkSubagents}" />
        <settings:WorkContextView IsVisible="{Binding IsWorkContext}" />
        <settings:RoleplayContextView IsVisible="{Binding IsRoleplayContext}" />
        <settings:RoleplayHeartbeatView IsVisible="{Binding IsRoleplayHeartbeat}" />
        <settings:RoleplayStatesView IsVisible="{Binding IsRoleplayStates}" />
        <settings:ToolSettingsView IsVisible="{Binding IsToolSettings}" />
        <settings:McpSettingsView IsVisible="{Binding IsMcpSettings}" />
        <settings:ModelsSettingsView IsVisible="{Binding IsModelsSettings}" />
        <settings:ChannelAccountsView IsVisible="{Binding IsChannelSettings}" />
        <settings:NotifySettingsView IsVisible="{Binding IsNotifySettings}" />
        <settings:ConfigFileSettingsView IsVisible="{Binding IsConfigFileSettings}" />
        <settings:MaintenanceSettingsView IsVisible="{Binding IsConfigMaintenance}" />
        <settings:PlaceholderSettingsView IsVisible="{Binding IsPlannedSettings}" />
      </Grid>

    </Grid>

  </Grid>
</UserControl>
