<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Shoyee.Desktop.ViewModels"
        xmlns:views="using:Shoyee.Desktop.Views"
        x:Class="Shoyee.Desktop.Views.ImportWindow"
        x:DataType="vm:MainViewModel"
        Title="会话导入"
        Width="1150" Height="780"
        MinWidth="900" MinHeight="640"
        WindowStartupLocation="CenterOwner"
        Icon="/Assets/app.png"
        Background="{DynamicResource BgBrush}"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="40">

  <Grid RowDefinitions="40,*">

    <Border Grid.Row="0"
            Background="{DynamicResource BgRaisedBrush}"
            BorderBrush="{DynamicResource BorderSoftBrush}"
            BorderThickness="0,0,0,1"
            PointerPressed="TitleBar_PointerPressed">
      <TextBlock Text="会话导入" FontSize="12.5" FontWeight="SemiBold"
                 Foreground="{DynamicResource TextDimBrush}"
                 HorizontalAlignment="Center" VerticalAlignment="Center" />
    </Border>

    <views:ImportView Grid.Row="1" />

  </Grid>
</Window>
