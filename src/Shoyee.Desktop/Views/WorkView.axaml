<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Shoyee.Desktop.ViewModels"
             xmlns:items="using:Shoyee.Desktop.ViewModels.Items"
             xmlns:theming="using:Shoyee.Desktop.Theming"
             x:Class="Shoyee.Desktop.Views.WorkView"
             x:DataType="vm:WorkViewModel">

  <Grid ColumnDefinitions="*,Auto">

    <!-- ================= 中：聊天 ================= -->
    <Grid Grid.Column="0" RowDefinitions="Auto,*,Auto">

      <Border Grid.Row="0" BorderBrush="{DynamicResource BorderSoftBrush}" BorderThickness="0,0,0,1">
        <Grid ColumnDefinitions="*,Auto" Margin="22,12">
          <StackPanel Spacing="2">
            <TextBlock Text="{Binding HeaderTitle}" Classes="h1" />
            <TextBlock Text="{Binding HeaderSubtitle}" Classes="caption" />
          </StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
            <Button Content="快照" Classes="ghost" FontSize="11.5" ToolTip.Tip="session.snapshot（占位）" />
            <Button Content="导出" Classes="ghost" FontSize="11.5" ToolTip.Tip="session.export（占位）" />
            <Button Classes="icon"
                    Command="{Binding ToggleRightPanelCommand}"
                    ToolTip.Tip="收起 / 展开状态栏">
              <PathIcon Data="{x:Static theming:IconGeometries.Board}" />
            </Button>
          </StackPanel>
        </Grid>
      </Border>

      <ScrollViewer Grid.Row="1" x:Name="MessageScroller" HorizontalScrollBarVisibility="Disabled">
        <ItemsControl ItemsSource="{Binding VisibleMessages}"
                      ItemTemplate="{StaticResource ChatMessageTemplate}"
                      MaxWidth="{Binding ContentMaxWidth}" Margin="24,20,24,8"
                      HorizontalAlignment="Stretch" />
      </ScrollViewer>

      <!-- 输入区 -->
      <Border Grid.Row="2"
              Background="{DynamicResource BgRaisedBrush}"
              BorderBrush="{DynamicResource BorderSoftBrush}"
              BorderThickness="0,1,0,0"
              Padding="22,12,22,14">
        <StackPanel MaxWidth="{Binding ContentMaxWidth}" HorizontalAlignment="Stretch">
          <!-- 审批条：回合内挂起，不答复会超时按拒绝收束 -->
          <Border IsVisible="{Binding HasPendingApproval}"
                  Margin="0,0,0,8"
                  Padding="14,11"
                  CornerRadius="12"
                  Background="{DynamicResource CardBrush}"
                  BorderBrush="{DynamicResource AccentBorderBrush}"
                  BorderThickness="1">
            <StackPanel Spacing="8">
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="{Binding PendingApproval.Title}" FontSize="12.5" FontWeight="SemiBold" />
                <TextBlock Grid.Column="1" Text="{Binding PendingApproval.ExpiryHint}" Classes="caption"
                           VerticalAlignment="Center" />
              </Grid>

              <ScrollViewer IsVisible="{Binding PendingApproval.HasCommand}"
                            MaxHeight="110"
                            HorizontalScrollBarVisibility="Disabled">
                <SelectableTextBlock Text="{Binding PendingApproval.Command}" Classes="mono"
                                     FontSize="11" LineHeight="17"
                                     Foreground="{DynamicResource TextMutedBrush}" />
              </ScrollViewer>

              <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="批准" Classes="ghost" FontSize="11.5"
                        Command="{Binding ApproveApprovalCommand}" />
                <Button Content="拒绝" Classes="ghost" FontSize="11.5"
                        Command="{Binding DenyApprovalCommand}" />
                <Button Content="本会话总是允许" Classes="ghost" FontSize="11.5"
                        Command="{Binding AlwaysApprovalCommand}"
                        ToolTip.Tip="只对当前会话生效" />
              </StackPanel>
            </StackPanel>
          </Border>

          <Border Background="{DynamicResource ComposerBrush}"
                  BorderBrush="{DynamicResource BorderSoftBrush}"
                  BorderThickness="1"
                  CornerRadius="14"
                  Padding="12">
            <Grid RowDefinitions="Auto,Auto">
              <TextBox Grid.Row="0"
                       x:Name="ComposerBox"
                       Classes="composer"
                       AcceptsReturn="True"
                       TextWrapping="Wrap"
                       MinHeight="64" MaxHeight="140"
                       PlaceholderText="{Binding ComposerWatermark}"
                       Text="{Binding Draft}" />

              <Grid Grid.Row="1" ColumnDefinitions="*,Auto" Margin="0,8,0,0">
                <StackPanel Orientation="Horizontal" Spacing="4">
                  <Button Classes="icon" ToolTip.Tip="附件（占位）">
                    <PathIcon Data="{x:Static theming:IconGeometries.Attach}" />
                  </Button>
                  <Button Classes="icon" ToolTip.Tip="图片（占位）">
                    <PathIcon Data="{x:Static theming:IconGeometries.Image}" />
                  </Button>
                  <Button Classes="icon" ToolTip.Tip="指令（占位）">
                    <PathIcon Data="{x:Static theming:IconGeometries.Command}" />
                  </Button>
                  <Button Classes="icon"
                          Classes.active="{Binding ShowToolCalls}"
                          Command="{Binding ToggleToolCallsCommand}"
                          ToolTip.Tip="{Binding ToolCallsTip}">
                    <PathIcon Data="{x:Static theming:IconGeometries.Wrench}" />
                  </Button>
                  <Button Classes="icon"
                          Classes.active="{Binding ShowReasoning}"
                          Command="{Binding ToggleReasoningCommand}"
                          ToolTip.Tip="{Binding ReasoningTip}">
                    <PathIcon Data="{x:Static theming:IconGeometries.Thought}" />
                  </Button>
                  <Button Classes="icon"
                          Classes.active="{Binding ShowSystemInputs}"
                          Command="{Binding ToggleSystemInputsCommand}"
                          ToolTip.Tip="{Binding SystemInputsTip}">
                    <PathIcon Data="{x:Static theming:IconGeometries.Info}" />
                  </Button>
                  <Button Classes="icon"
                          Classes.active="{Binding SendOnEnter}"
                          Command="{Binding ToggleSendShortcutCommand}"
                          ToolTip.Tip="{Binding SendShortcutTip}">
                    <PathIcon Data="{x:Static theming:IconGeometries.ReturnKey}" />
                  </Button>
                  <Button Classes="icon"
                          Classes.active="{Binding IsWideBubbles}"
                          Command="{Binding ToggleBubbleWidthCommand}"
                          ToolTip.Tip="{Binding BubbleWidthTip}">
                    <PathIcon Data="{Binding BubbleWidthIcon}" />
                  </Button>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10"
                            VerticalAlignment="Center">
                  <TextBlock Text="{Binding ModelName}" Classes="caption"
                             FontWeight="SemiBold" Foreground="{DynamicResource TextDimBrush}"
                             VerticalAlignment="Center" ToolTip.Tip="{Binding ModelDetail}" />

                  <TextBlock Text="{Binding CacheHitText}" FontSize="12" FontWeight="SemiBold"
                             VerticalAlignment="Center" ToolTip.Tip="{Binding CacheHitTip}"
                             Classes.cache-high="{Binding IsCacheHigh}"
                             Classes.cache-medium="{Binding IsCacheMedium}"
                             Classes.cache-low="{Binding IsCacheLow}" />

                  <Button Classes="context" ToolTip.Tip="{Binding ContextUsageTip}">
                    <Button.Flyout>
                      <Flyout Placement="Top">
                        <Border Classes="card" Padding="16" Width="310">
                          <StackPanel Spacing="12">
                            <StackPanel Spacing="2">
                              <TextBlock Text="上下文用量" Classes="label" />
                              <TextBlock Text="{Binding ContextUsageText}"
                                         FontSize="16" FontWeight="SemiBold" />
                              <TextBlock Text="{Binding ModelName}" Classes="caption" />
                            </StackPanel>

                            <StackPanel Spacing="7">
                              <Grid ColumnDefinitions="Auto,*,Auto">
                                <PathIcon Data="{x:Static theming:IconGeometries.Chat}"
                                          Width="12" Height="12" VerticalAlignment="Center"
                                          Foreground="{DynamicResource TextMutedBrush}" />
                                <TextBlock Grid.Column="1" Text="正文" Classes="muted"
                                           Margin="7,0,0,0" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="2" Text="{Binding BodyTokenText}"
                                           FontSize="11.5" VerticalAlignment="Center" />
                              </Grid>
                              <ProgressBar Value="{Binding BodyPercent}" Maximum="100"
                                           MinWidth="0" Height="4" />
                              <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,2,0,0">
                                <PathIcon Data="{x:Static theming:IconGeometries.Thought}"
                                          Width="12" Height="12" VerticalAlignment="Center"
                                          Foreground="{DynamicResource TextMutedBrush}" />
                                <TextBlock Grid.Column="1" Text="思考" Classes="muted"
                                           Margin="7,0,0,0" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="2" Text="{Binding ReasoningTokenText}"
                                           FontSize="11.5" VerticalAlignment="Center" />
                              </Grid>
                              <ProgressBar Value="{Binding ReasoningPercent}" Maximum="100"
                                           MinWidth="0" Height="4" />
                              <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,2,0,0">
                                <PathIcon Data="{x:Static theming:IconGeometries.Wrench}"
                                          Width="12" Height="12" VerticalAlignment="Center"
                                          Foreground="{DynamicResource TextMutedBrush}" />
                                <TextBlock Grid.Column="1" Text="工具" Classes="muted"
                                           Margin="7,0,0,0" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="2" Text="{Binding ToolTokenText}"
                                           FontSize="11.5" VerticalAlignment="Center" />
                              </Grid>
                              <ProgressBar Value="{Binding ToolPercent}" Maximum="100"
                                           MinWidth="0" Height="4" />
                            </StackPanel>

                            <Separator />

                            <StackPanel Spacing="4">
                              <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Text="缓存命中" Classes="muted" />
                                <TextBlock Grid.Column="1" Text="{Binding CacheHitText}"
                                           FontSize="12.5" FontWeight="SemiBold"
                                           Classes.cache-high="{Binding IsCacheHigh}"
                                           Classes.cache-medium="{Binding IsCacheMedium}"
                                           Classes.cache-low="{Binding IsCacheLow}" />
                              </Grid>
                              <TextBlock Text="{Binding CacheUsageText}" Classes="caption" />
                            </StackPanel>

                            <TextBlock Text="{Binding ContextSourceNote}"
                                       Classes="caption" TextWrapping="Wrap" />
                          </StackPanel>
                        </Border>
                      </Flyout>
                    </Button.Flyout>

                    <Grid VerticalAlignment="Center">
                      <Border IsVisible="{Binding IsContextElectric}"
                              BoxShadow="0 0 10 1 #99E58B8B"
                              CornerRadius="7" Margin="-5,-3" />
                      <PathIcon Data="{x:Static theming:IconGeometries.Bolt}"
                                Width="6" Height="11" Margin="-12,0,0,0"
                                HorizontalAlignment="Left" VerticalAlignment="Center"
                                Foreground="{DynamicResource DangerBrush}"
                                IsVisible="{Binding IsContextElectric}" />
                      <StackPanel Classes="context-bars" Orientation="Horizontal" Spacing="2"
                                  Classes.mint="{Binding IsContextGreen}"
                                  Classes.gold="{Binding IsContextYellow}"
                                  Classes.danger="{Binding IsContextRed}">
                        <Border Classes="ctx-bar" Classes.filled="{Binding ContextBar1}" />
                        <Border Classes="ctx-bar" Classes.filled="{Binding ContextBar2}" />
                        <Border Classes="ctx-bar" Classes.filled="{Binding ContextBar3}" />
                        <Border Classes="ctx-bar" Classes.filled="{Binding ContextBar4}" />
                        <Border Classes="ctx-bar" Classes.filled="{Binding ContextBar5}" />
                        <Border Classes="ctx-bar" Classes.filled="{Binding ContextBar6}" />
                        <Border Classes="ctx-bar" Classes.filled="{Binding ContextBar7}" />
                        <Border Classes="ctx-bar" Classes.filled="{Binding ContextBar8}" />
                        <Border Classes="ctx-bar" Classes.filled="{Binding ContextBar9}" />
                        <Border Classes="ctx-bar" Classes.filled="{Binding ContextBar10}" />
                      </StackPanel>
                      <PathIcon Data="{x:Static theming:IconGeometries.Bolt}"
                                Width="6" Height="11" Margin="0,0,-12,0"
                                HorizontalAlignment="Right" VerticalAlignment="Center"
                                Foreground="{DynamicResource DangerBrush}"
                                IsVisible="{Binding IsContextElectric}" />
                    </Grid>
                  </Button>

                  <Button Classes="send" ToolTip.Tip="终止本轮"
                          Background="{DynamicResource DangerBrush}"
                          IsVisible="{Binding IsTurnRunning}"
                          Command="{Binding StopCommand}">
                    <PathIcon Data="{x:Static theming:IconGeometries.Stop}"
                              Width="14" Height="14" />
                  </Button>

                  <Button Classes="send" ToolTip.Tip="发送"
                          Command="{Binding SendCommand}">
                    <Path Data="M2,21 L23,12 L2,3 L2,10 L17,12 L2,14 Z"
                          Fill="{DynamicResource OnAccentBrush}"
                          Stretch="Uniform" Width="15" Height="15" />
                  </Button>
                </StackPanel>
              </Grid>
            </Grid>
          </Border>
        </StackPanel>
      </Border>
    </Grid>

    <!-- ================= 右：可折叠状态栏 ================= -->
    <Border Grid.Column="1"
            Width="300"
            IsVisible="{Binding IsRightPanelOpen}"
            Background="{DynamicResource BgRaisedBrush}"
            BorderBrush="{DynamicResource BorderSoftBrush}"
            BorderThickness="1,0,0,0">
      <Grid RowDefinitions="Auto,*">
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="16,14,10,6">
          <TextBlock Text="状态" Classes="label" VerticalAlignment="Center" />
          <Button Grid.Column="1" Content="×" Classes="icon"
                  Command="{Binding ToggleRightPanelCommand}" ToolTip.Tip="收起状态栏" />
        </Grid>

        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled">
          <StackPanel Margin="16,6,16,18" Spacing="14">

            <StackPanel Spacing="8">
              <TextBlock Text="会话" Classes="label" />
              <Border Classes="card" Padding="14">
                <StackPanel Spacing="9">
                  <Grid ColumnDefinitions="66,*">
                    <TextBlock Text="消息" Classes="muted" />
                    <TextBlock Grid.Column="1" Text="{Binding SelectedSession.MessageCount}" Classes="dim" />
                  </Grid>
                  <Grid ColumnDefinitions="66,*">
                    <TextBlock Text="创建" Classes="muted" />
                    <TextBlock Grid.Column="1" Text="{Binding SelectedSession.CreatedText}" Classes="dim" />
                  </Grid>
                  <Grid ColumnDefinitions="66,*">
                    <TextBlock Text="来源" Classes="muted" />
                    <TextBlock Grid.Column="1" Text="{Binding SelectedSession.Source}" Classes="dim" />
                  </Grid>
                  <Grid ColumnDefinitions="66,*">
                    <TextBlock Text="Lane" Classes="muted" />
                    <TextBlock Grid.Column="1" Text="{Binding SelectedSession.LaneId}"
                               Classes="mono muted" TextTrimming="CharacterEllipsis" MaxLines="1" />
                  </Grid>
                  <Grid ColumnDefinitions="66,*">
                    <TextBlock Text="模型" Classes="muted" />
                    <TextBlock Grid.Column="1" Text="{Binding ModelName}" Classes="dim"
                               ToolTip.Tip="{Binding ModelDetail}" />
                  </Grid>
                  <StackPanel Spacing="5">
                    <Grid ColumnDefinitions="66,*">
                      <TextBlock Text="上下文" Classes="muted" />
                      <TextBlock Grid.Column="1" Text="{Binding ContextUsageText}" Classes="dim" />
                    </Grid>
                    <ProgressBar Value="{Binding ContextUsagePercent}" Maximum="100"
                                 Classes.gold="{Binding IsContextHigh}" />
                    <TextBlock Text="{Binding ContextSourceNote}" TextWrapping="Wrap"
                               Classes="caption" />
                  </StackPanel>
                  <Grid ColumnDefinitions="66,*">
                    <TextBlock Text="缓存命中" Classes="muted" />
                    <TextBlock Grid.Column="1" Text="{Binding CacheHitText}"
                               FontSize="12" FontWeight="SemiBold"
                               Classes.cache-high="{Binding IsCacheHigh}"
                               Classes.cache-medium="{Binding IsCacheMedium}"
                               Classes.cache-low="{Binding IsCacheLow}" />
                  </Grid>
                  <TextBlock Text="{Binding CacheUsageText}" Classes="caption" />
                </StackPanel>
              </Border>
            </StackPanel>

            <StackPanel Spacing="8">
              <TextBlock Text="她的状态" Classes="label" />
              <Border Classes="card" Padding="14">
                <ItemsControl ItemsSource="{Binding States}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <StackPanel Spacing="12" />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="items:StateItem">
                      <StackPanel Spacing="5">
                        <Grid ColumnDefinitions="*,Auto">
                          <TextBlock Text="{Binding Name}" Classes="muted" />
                          <TextBlock Grid.Column="1" Text="{Binding Value}" FontSize="12.5" FontWeight="SemiBold" />
                        </Grid>
                        <ProgressBar Value="{Binding Percent}" Maximum="100"
                                     IsVisible="{Binding IsNumeric}"
                                     Classes.mint="{Binding IsMint}"
                                     Classes.gold="{Binding IsGold}" />
                      </StackPanel>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </Border>
            </StackPanel>

            <StackPanel Spacing="8">
              <TextBlock Text="今日用量" Classes="label" />
              <Border Classes="card" Padding="14">
                <StackPanel Spacing="10">
                  <Grid ColumnDefinitions="*,*,*">
                    <StackPanel Spacing="2">
                      <TextBlock Text="61" FontSize="17" FontWeight="SemiBold" />
                      <TextBlock Text="调用" Classes="caption" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Spacing="2">
                      <TextBlock Text="412k" FontSize="17" FontWeight="SemiBold" />
                      <TextBlock Text="输入" Classes="caption" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Spacing="2">
                      <TextBlock Text="18.8k" FontSize="17" FontWeight="SemiBold" />
                      <TextBlock Text="输出" Classes="caption" />
                    </StackPanel>
                  </Grid>

                </StackPanel>
              </Border>
            </StackPanel>

            <StackPanel Spacing="8">
              <TextBlock Text="快捷入口" Classes="label" />
              <StackPanel Spacing="6">
                <Button Content="定时任务" Classes="ghost" HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Left" ToolTip.Tip="占位" />
                <Button Content="生成一张图" Classes="ghost" HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Left" ToolTip.Tip="image.render（占位）" />
                <Button Content="查看冻结提示词" Classes="ghost" HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Left" ToolTip.Tip="session.snapshot（占位）" />
              </StackPanel>
            </StackPanel>

            <TextBlock Text="全部按钮暂未接线，仅用于确认布局与视觉。"
                       Classes="caption" Margin="2,4,0,8" />

          </StackPanel>
        </ScrollViewer>
      </Grid>
    </Border>

  </Grid>
</UserControl>
